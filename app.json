{
  "expo": {
    "name": "TOCHKA Fitness",
    "slug": "gymlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dyshnila.gymlog",
      "adaptiveIcon": {
        "backgroundColor": "#ECECEA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "TOCHKA Fitness использует фото, чтобы заменить картинку блюда на ваше.",
          "cameraPermission": "TOCHKA Fitness использует камеру, чтобы сфотографировать блюдо.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-sharing",
      "expo-notifications"
    ],
    "scheme": "gymlog",
    "backgroundColor": "#000000"
  }
}
